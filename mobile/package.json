{
  "name": "mindmesh-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web --port 8310",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "expo": "57.0.27",
    "expo-constants": "57.0.21",
    "expo-device": "57.0.2",
    "expo-linking": "57.0.12",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg)"
    ]
  }
}
