# Copy to .env and fill in.

# dev | test | prod. Outside dev/test, JWT_SECRET is required.
APP_ENV=dev
JWT_SECRET=change-me-to-a-long-random-string

# Leave empty to run fully offline with the deterministic mock AI provider.
ANTHROPIC_API_KEY=
# Optional overrides. "main" is used for tutoring and grading, "fast" for question generation.
# ANTHROPIC_MODEL_MAIN=claude-sonnet-4-5
# ANTHROPIC_MODEL_FAST=claude-haiku-4-5

# Per-user rolling 24h token budget (0 = unlimited).
DAILY_TOKEN_BUDGET=2000000
MAX_UPLOAD_MB=50
MAX_PAGES=1000

# Retrieval: "hash" = built-in hybrid (BM25 + hashed n-gram vectors); "none" = BM25 only
EMBEDDER=hash
# OCR for scanned pages: off | tesseract
OCR=off
# Background jobs: inline (in API process) | db (separate worker service; docker-compose sets this)
JOB_BACKEND=inline
# Per-user/IP limit on write + AI requests per minute (0 = off; defaults to 60 in prod)
RATE_LIMIT_PER_MINUTE=0
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set only when behind a trusted reverse proxy
# TRUST_PROXY=1
# Shared rate limits + signed-out report cache across API processes (docker compose sets this).
# Unset = per-process, in memory: fine for a single process.
# REDIS_URL=redis://localhost:6379/0

# Logs: json | text (default json when APP_ENV=prod, else text). Every line has a request_id.
# LOG_FORMAT=json
# LOG_LEVEL=INFO
# Error tracking (Sentry or any Sentry-compatible service). Off when empty. Events never
# include request bodies, local variables, cookies, auth headers or query strings.
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# RELEASE=

# Malware scanning of uploads via a ClamAV daemon: off | clamd. When on, it fails closed
# (uploads are refused with 503 if clamd can't be reached).
UPLOAD_SCAN=off
# CLAMD_HOST=localhost
# CLAMD_PORT=3310

# Sign-in: local (email + password; dev, tests, offline) | clerk
AUTH_PROVIDER=local
# Clerk (AUTH_PROVIDER=clerk). From the Clerk Dashboard > API keys. Never commit real values.
# CLERK_FRONTEND_API_URL=https://<your-app>.clerk.accounts.dev
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# CLERK_SECRET_KEY=sk_test_...
# CLERK_AUTHORIZED_PARTIES=http://localhost:3300
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Email: reminders + weekly summary (only for users who turn reminders on in Settings).
# off | console (dev default: logged, not sent) | smtp (Resend, Postmark, SES... all speak SMTP)
EMAIL_BACKEND=console
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # starttls | ssl | none
# SMTP_USERNAME=resend
# SMTP_PASSWORD=
# EMAIL_FROM="Mindmesh <hello@your-domain>"
# EMAIL_TOKEN_SECRET=      # signs unsubscribe links; required with smtp in prod
# WEB_URL=http://localhost:3300
# API_PUBLIC_URL=http://localhost:8300
# REMINDER_LOCAL_HOUR=18
# WEEKLY_SUMMARY_LOCAL_HOUR=9
# DIGEST_EVERY_SECONDS=300 # worker.py tick; without a worker run: python -m app.tools.send_digests

# Database pool per API process (Postgres). Keep pool x processes under max_connections.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=10        # seconds; an exhausted pool answers 503 + Retry-After

# --- P1 wave 6 ---
# After processing, one fast-model call per document lists the concepts it teaches (knowledge graph).
# CONCEPT_EXTRACTION=on
# Job ad imports from a link, per IP per hour (signed out).
# PUBLIC_JOB_URL_PER_IP_PER_HOUR=20

# --- P1 wave 7: analytics and retention ---
# Onboarding experiment: on (50/50) | off (goal-first only) | goal_first | upload_first
# EXPERIMENT_ONBOARDING=on
# Retention in days (0 = keep). Legal periods are still [DECISION]s in docs/legal/retention-policy.md.
# RETENTION_EMAIL_LOG_DAYS=0
# RETENTION_USAGE_DAYS=0
# RETENTION_EVENTS_DAYS=0
# RETENTION_JOBS_DAYS=30
# PURGE_EVERY_SECONDS=3600

# --- P2: learned embeddings and metrics ---
# Dense retrieval (off by default). voyage needs VOYAGE_API_KEY; then run python -m evals.calibrate_dense.
# DENSE_EMBEDDER=off
# VOYAGE_API_KEY=
# DENSE_MODEL=voyage-3.5
# DENSE_DIM=1024
# DENSE_FOUND_THRESHOLD=
# Prometheus metrics at /api/metrics (off unless set): Authorization: Bearer <token>
# METRICS_TOKEN=

# --- P3: push notifications and workers ---
# PUSH_BACKEND=off            # off | console (dev) | expo
# EXPO_ACCESS_TOKEN=          # only if enhanced push security is on for the Expo project
# WORKER_CONCURRENCY=1        # jobs in parallel per worker process
